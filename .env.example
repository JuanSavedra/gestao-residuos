# Configurações do Banco de Dados (PostgreSQL / AWS RDS)
# Exemplo local: jdbc:postgresql://localhost:5432/gestao_residuos
# Exemplo RDS: jdbc:postgresql://<endpoint-rds>:5432/gestao_residuos
DB_URL=jdbc:postgresql://postgres-db:5432/gestao_residuos
DB_USER=postgres
DB_PASS=postgres

# Configurações da Aplicação Spring Boot
SERVER_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Configurações de Deploy (AWS EC2)
# Estas variáveis são usadas principalmente como GitHub Secrets
PROD_HOST=seu-ip-ec2
PROD_USER=ec2-user
SSH_PRIVATE_KEY=conteudo-do-arquivo-pem

# Configurações do ambiente
# Opções: staging, production
ENVIRONMENT=staging
